---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaCard from '../../components/MediaCard.astro';
import { getCollection } from 'astro:content';
import { searchText } from '../../lib/altTitles';

const allBooks = (await getCollection('books')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const top10 = [...allBooks].filter(b => b.data.rating > 0).sort((a, b) => b.data.rating - a.data.rating).slice(0, 10);
const genres = [...new Set(allBooks.flatMap(b => b.data.genre.split(',').map(g => g.trim())).filter(Boolean))].sort();
const reading = allBooks.filter(b => b.data.status === 'reading');
const readCount = allBooks.filter(b => b.data.status === 'read').length;
const totalPages = allBooks
  .filter(b => b.data.status === 'read')
  .reduce((sum, b) => sum + (b.data.pages || 0), 0);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Sách" description="Những cuốn sách mình đã đọc, đang đọc và muốn đọc" activeNav="books">
  <h1 class="sr-only">Sách</h1>

  {allBooks.length === 0 ? (
    <section class="books-empty reveal">
      <div class="books-empty-icon" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5V5a2 2 0 0 1 2-2h13v16H6.5a2.5 2.5 0 0 0 0 5H19"/>
          <path d="M8 7h7M8 11h5"/>
        </svg>
      </div>
      <p class="books-empty-title">Kệ sách đang được sắp xếp</p>
      <p class="books-empty-desc">Danh sách sách đang được tạo. Quay lại sau nhé.</p>
    </section>
  ) : (
    <>
      <section class="reveal" style="margin-bottom: 28px;">
        <div class="books-summary">
          <div class="books-summary-item"><strong>{allBooks.length}</strong><span>Tổng số</span></div>
          <div class="books-summary-item"><strong>{readCount}</strong><span>Đã đọc</span></div>
          <div class="books-summary-item"><strong>{reading.length}</strong><span>Đang đọc</span></div>
          {totalPages > 0 && <div class="books-summary-item"><strong>{totalPages.toLocaleString('vi-VN')}</strong><span>Trang đã đọc</span></div>}
        </div>
      </section>

      {top10.length > 0 && (
        <section class="reveal" style="margin-bottom: 32px;">
          <p class="section-label">Top 10 — Điểm cao nhất</p>
          <hr class="section-divider" />
          <div class="top-carousel">
            {top10.map((item, i) => (
              <a href={`${base}books/${item.id}/`} class="top-card" data-type="book">
                <span class="top-rank">#{i + 1}</span>
                <span class="cover-fallback">{item.data.title.slice(0, 1)}</span>
                {item.data.cover && <img src={item.data.cover} alt={item.data.title} loading="lazy" decoding="async" onerror="this.hidden=true" />}
                <div class="top-overlay">
                  <p class="top-title">{item.data.title}</p>
                  <div class="top-scores">
                    <span class="top-score" style="color: var(--book-color);">{item.data.rating}<small>/10</small></span>
                    <span class="top-score-sub">{item.data.author}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section style="margin-bottom: 24px;">
        <div class="filter-bar">
          <input type="text" id="search" class="filter-input" placeholder="Tìm sách, tác giả..." autocomplete="off" />
          <select id="genre-filter" class="filter-select">
            <option value="">Tất cả thể loại</option>
            {genres.map(g => <option value={g}>{g}</option>)}
          </select>
          <select id="status-filter" class="filter-select">
            <option value="">Tất cả trạng thái</option>
            <option value="reading">Đang đọc</option>
            <option value="read">Đã đọc</option>
            <option value="plan">Muốn đọc</option>
            <option value="dropped">Bỏ dở</option>
          </select>
          <select id="sort-filter" class="filter-select">
            <option value="rating">Điểm ↓</option>
            <option value="date">Mới nhất</option>
            <option value="title">A → Z</option>
            <option value="year">Năm ↓</option>
            <option value="pages">Số trang ↓</option>
          </select>
        </div>
        <p class="section-label" style="margin-top: 16px;">
          Kệ sách — <span id="count">{allBooks.length}</span> cuốn
        </p>
      </section>

      <div class="media-grid" id="media-grid" data-filter-page="books">
        {allBooks.map((item, i) => (
          <div class="filter-item"
            data-title={item.data.title.toLowerCase()}
            data-search={searchText(item.data.title, item.data, item.data.author)}
            data-genre={item.data.genre.toLowerCase()}
            data-status={item.data.status}
            data-rating={item.data.rating}
            data-pages={item.data.pages || 0}
            data-year={item.data.year}
            data-date={new Date(item.data.date).getTime()}>
            <MediaCard
              title={item.data.title}
              type="book"
              rating={item.data.rating}
              genre={item.data.author}
              year={item.data.year}
              cover={item.data.cover}
              status={item.data.status}
              slug={item.id}
              index={i}
            />
          </div>
        ))}
      </div>
    </>
  )}

  <script>
    function initBookFilters() {
      const search = document.getElementById('search') as HTMLInputElement | null;
      const genre = document.getElementById('genre-filter') as HTMLSelectElement | null;
      const status = document.getElementById('status-filter') as HTMLSelectElement | null;
      const sort = document.getElementById('sort-filter') as HTMLSelectElement | null;
      const grid = document.getElementById('media-grid');
      const count = document.getElementById('count');
      if (!search || !genre || !status || !sort || !grid || !count) return;
      if (grid.dataset.filterPage !== 'books' || grid.dataset.filterBound === 'books') return;
      grid.dataset.filterBound = 'books';

      const params = new URLSearchParams(window.location.search);
      search.value = params.get('q') || '';
      for (const [select, key] of [[genre, 'genre'], [status, 'status'], [sort, 'sort']] as const) {
        const value = params.get(key);
        if (value && [...select.options].some(o => o.value === value)) select.value = value;
      }

      function apply(updateAddress = true) {
        const q = search!.value.toLowerCase();
        const g = genre!.value.toLowerCase();
        const s = status!.value;
        const sv = sort!.value;
        const items = [...grid!.querySelectorAll('.filter-item')] as HTMLElement[];
        items.sort((a, b) => {
          if (sv === 'rating') return parseFloat(b.dataset.rating!) - parseFloat(a.dataset.rating!);
          if (sv === 'title') return a.dataset.title!.localeCompare(b.dataset.title!);
          if (sv === 'year') return parseInt(b.dataset.year!) - parseInt(a.dataset.year!);
          if (sv === 'pages') return parseInt(b.dataset.pages!) - parseInt(a.dataset.pages!);
          return parseFloat(b.dataset.date!) - parseFloat(a.dataset.date!);
        });
        items.forEach(el => grid!.appendChild(el));
        let visible = 0;
        items.forEach(el => {
          const ok = (!q || el.dataset.search!.includes(q)) &&
            (!g || el.dataset.genre!.includes(g)) &&
            (!s || el.dataset.status === s);
          el.style.display = ok ? '' : 'none';
          if (ok) visible++;
        });
        count!.textContent = String(visible);
        if (!updateAddress) return;
        const url = new URL(window.location.href);
        const setParam = (key: string, value: string, fallback = '') => {
          if (!value || value === fallback) url.searchParams.delete(key);
          else url.searchParams.set(key, value);
        };
        setParam('q', search!.value.trim());
        setParam('genre', genre!.value);
        setParam('status', status!.value);
        setParam('sort', sort!.value, 'rating');
        window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      }

      apply(false);
      search.addEventListener('input', () => apply());
      [genre, status, sort].forEach(el => el.addEventListener('change', () => apply()));
    }
    initBookFilters();
    if (document.documentElement.dataset.bookFiltersEventsBound !== 'true') {
      document.documentElement.dataset.bookFiltersEventsBound = 'true';
      document.addEventListener('astro:page-load', initBookFilters);
    }
  </script>
</BaseLayout>
