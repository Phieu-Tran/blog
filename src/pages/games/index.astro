---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaCard from '../../components/MediaCard.astro';
import { getCollection } from 'astro:content';

const allGames = (await getCollection('games')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const top10 = [...allGames].sort((a, b) => b.data.rating - a.data.rating).slice(0, 10);
const genres = [...new Set(allGames.flatMap(g => g.data.genre.split(',').map(x => x.trim())).filter(Boolean))].sort();
const platforms = [...new Set(allGames.flatMap(g => g.data.platform.split(',').map(x => x.trim())).filter(Boolean))].sort();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Games" activeNav="games">
  {/* Top 10 */}
  <section class="reveal" style="margin-bottom: 32px;">
    <p class="section-label">Top 10 — Điểm cao nhất</p>
    <hr class="section-divider" />
    <div class="top-carousel">
      {top10.map((item, i) => (
        <a href={`${base}games/${item.id}/`} class="top-card" data-type="game">
          <span class="top-rank">#{i + 1}</span>
          <span class="cover-fallback">{item.data.title.slice(0, 1)}</span>
          {item.data.cover && <img src={item.data.cover} alt={item.data.title} loading="lazy" onerror="this.hidden=true" />}
          <div class="top-overlay">
            <p class="top-title">{item.data.title}</p>
            <div class="top-scores">
              <span class="top-score" style="color: var(--game-color);">{item.data.rating}<small>/10</small></span>
              {item.data.igdb_score && <span class="top-score-sub">IGDB {item.data.igdb_score}</span>}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* Search + Filter */}
  <section style="margin-bottom: 24px;">
    <div class="filter-bar">
      <input type="text" id="search" class="filter-input" placeholder="Tìm game..." autocomplete="off" />
      <select id="genre-filter" class="filter-select">
        <option value="">Tất cả thể loại</option>
        {genres.map(g => <option value={g}>{g}</option>)}
      </select>
      <select id="status-filter" class="filter-select">
        <option value="">Tất cả trạng thái</option>
        <option value="playing">Đang chơi</option>
        <option value="completed">Đã xong</option>
        <option value="plan">Dự định</option>
        <option value="dropped">Bỏ</option>
      </select>
      <select id="source-filter" class="filter-select">
        <option value="">All sources</option>
        <option value="steam">Steam library</option>
        <option value="igdb">IGDB list</option>
        <option value="manual">Manual</option>
        <option value="igdb-score">Has IGDB Score</option>
        <option value="recent">Recently Played</option>
      </select>
      <select id="platform-filter" class="filter-select">
        <option value="">All platforms</option>
        {platforms.map(p => <option value={p}>{p}</option>)}
      </select>
      <select id="sort-filter" class="filter-select">
        <option value="rating">My Score ↓</option>
        <option value="date">Mới nhất</option>
        <option value="igdb">IGDB Score ↓</option>
        <option value="title">A → Z</option>
        <option value="year">Năm ↓</option>
      </select>
    </div>
    <div class="quick-filters" aria-label="Quick game filters">
      <button type="button" class="quick-filter active" data-quick="">All</button>
      <button type="button" class="quick-filter" data-quick="active">Active</button>
      <button type="button" class="quick-filter" data-quick="completed">Completed</button>
      <button type="button" class="quick-filter" data-quick="top">Top Rated</button>
      <button type="button" class="quick-filter" data-quick="recent">Recent</button>
      <button type="button" class="quick-filter" data-quick="missing-cover">Missing Cover</button>
    </div>
    <p class="section-label" style="margin-top: 16px;">
      Bộ sưu tập Game — <span id="count">{allGames.length}</span> tựa
    </p>
  </section>

  <div class="media-grid" id="media-grid">
    {allGames.map((item, i) => (
      <div class="filter-item"
        data-title={item.data.title.toLowerCase()}
        data-genre={item.data.genre.toLowerCase()}
        data-status={item.data.status}
        data-source={item.data.source}
        data-rating={item.data.rating}
        data-igdb={item.data.igdb_score || 0}
        data-platform={item.data.platform.toLowerCase()}
        data-has-igdb={item.data.igdb_id ? 'true' : 'false'}
        data-has-cover={item.data.cover ? 'true' : 'false'}
        data-steam-recent={item.data.steam_recent ? 'true' : 'false'}
        data-year={item.data.year}
        data-date={new Date(item.data.date).getTime()}>
        <MediaCard
          title={item.data.title}
          type="game"
          rating={item.data.rating}
          genre={item.data.genre}
          year={item.data.year}
          cover={item.data.cover}
          status={item.data.status}
          slug={item.id}
          index={i}
        />
      </div>
    ))}
  </div>

  <script>
    function initFilters() {
      const search = document.getElementById('search') as HTMLInputElement;
      const genre = document.getElementById('genre-filter') as HTMLSelectElement;
      const status = document.getElementById('status-filter') as HTMLSelectElement;
      const source = document.getElementById('source-filter') as HTMLSelectElement;
      const platformFilter = document.getElementById('platform-filter') as HTMLSelectElement;
      const sort = document.getElementById('sort-filter') as HTMLSelectElement;
      const quickButtons = [...document.querySelectorAll('.quick-filter')] as HTMLButtonElement[];
      const grid = document.getElementById('media-grid');
      const count = document.getElementById('count');
      if (!search || !genre || !status || !source || !platformFilter || !sort || !grid || !count) return;
      let quick = '';

      function apply() {
        const q = search.value.toLowerCase();
        const g = genre.value.toLowerCase();
        const s = status.value;
        const sourceValue = source.value;
        const platformValue = platformFilter.value.toLowerCase();
        const items = [...grid.querySelectorAll('.filter-item')] as HTMLElement[];
        const sv = sort.value;
        items.sort((a, b) => {
          if (sv === 'rating') return parseFloat(b.dataset.rating!) - parseFloat(a.dataset.rating!);
          if (sv === 'igdb') return parseFloat(b.dataset.igdb!) - parseFloat(a.dataset.igdb!);
          if (sv === 'title') return a.dataset.title!.localeCompare(b.dataset.title!);
          if (sv === 'year') return parseInt(b.dataset.year!) - parseInt(a.dataset.year!);
          return parseFloat(b.dataset.date!) - parseFloat(a.dataset.date!);
        });
        items.forEach(el => grid.appendChild(el));
        let v = 0;
        items.forEach(el => {
          const platform = el.dataset.platform || '';
          const itemSource = el.dataset.source || 'manual';
          const sourceOk = !sourceValue ||
            (sourceValue === itemSource) ||
            (sourceValue === 'igdb-score' && parseFloat(el.dataset.igdb || '0') > 0) ||
            (sourceValue === 'recent' && el.dataset.steamRecent === 'true');
          const platformOk = !platformValue || platform.includes(platformValue);
          const quickOk = !quick ||
            (quick === 'active' && (el.dataset.status === 'playing' || el.dataset.steamRecent === 'true')) ||
            (quick === 'completed' && el.dataset.status === 'completed') ||
            (quick === 'top' && parseFloat(el.dataset.rating || '0') >= 9) ||
            (quick === 'recent' && el.dataset.steamRecent === 'true') ||
            (quick === 'missing-cover' && el.dataset.hasCover !== 'true');
          const ok = (!q || el.dataset.title!.includes(q)) &&
                     (!g || el.dataset.genre!.includes(g)) &&
                     (!s || el.dataset.status === s) &&
                     sourceOk &&
                     platformOk &&
                     quickOk;
          el.style.display = ok ? '' : 'none';
          if (ok) v++;
        });
        count.textContent = String(v);
      }
      search.addEventListener('input', apply);
      genre.addEventListener('change', apply);
      status.addEventListener('change', apply);
      source.addEventListener('change', apply);
      platformFilter.addEventListener('change', apply);
      sort.addEventListener('change', apply);
      quickButtons.forEach(button => {
        button.addEventListener('click', () => {
          quick = button.dataset.quick || '';
          quickButtons.forEach(item => item.classList.toggle('active', item === button));
          apply();
        });
      });
    }
    initFilters();
    document.addEventListener('astro:after-swap', initFilters);
  </script>
</BaseLayout>
