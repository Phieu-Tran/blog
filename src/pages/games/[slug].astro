---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { postMatchesMedia } from '../../lib/mediaRelations';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const allPosts = (await getCollection('posts')).filter(p => !p.data.draft);
const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  steam_appid,
  igdb_id,
  igdb_url,
  steam_url,
  ign_url,
  metacritic_url,
  official_url,
  rating,
  igdb_score,
  genre,
  year,
  studio,
  publisher,
  director,
  creator,
  writer,
  composer,
  author,
  status,
  source,
  platform,
  playtime_hours,
  cover,
  date,
} = entry.data;

const relatedPosts = allPosts.filter(post => postMatchesMedia(post, 'games', entry.id));

function scoreColorFor(score: number) {
  if (score >= 9) return '#34D399';
  if (score >= 7) return '#FBBF24';
  if (score >= 5) return '#FB923C';
  return '#EF4444';
}

function scoreLabelFor(score: number) {
  if (score >= 9) return 'AMAZING';
  if (score >= 8) return 'GREAT';
  if (score >= 7) return 'GOOD';
  if (score >= 5) return 'OKAY';
  return 'BAD';
}

const scoreColor = rating > 0 ? scoreColorFor(rating) : '#6B7280';
const scoreLabel = rating > 0 ? scoreLabelFor(rating) : 'UNRATED';
const igdbScoreColor = igdb_score && igdb_score > 0 ? scoreColorFor(igdb_score) : '#6B7280';
const igdbScoreLabel = igdb_score && igdb_score > 0 ? scoreLabelFor(igdb_score) : 'NO SCORE';

const statusLabels: Record<string, string> = {
  playing: 'Playing',
  completed: 'Completed',
  plan: 'Backlog',
  dropped: 'Dropped',
};

const sourceLabels: Record<string, string> = {
  steam: 'Steam',
  igdb: 'IGDB',
  manual: 'Manual',
};
const sourceLabel = sourceLabels[source] || 'Manual';

const encodedTitle = encodeURIComponent(title);
const steamStoreUrl = steam_url || (steam_appid ? `https://store.steampowered.com/app/${steam_appid}` : null);
const igdbPageUrl = igdb_url || (igdb_id ? `https://www.igdb.com/search?type=1&q=${encodedTitle}` : null);
const ignPageUrl = ign_url || `https://www.ign.com/search?q=${encodedTitle}`;
const metacriticPageUrl = metacritic_url || `https://www.metacritic.com/search/${encodedTitle}/?category=13`;
const externalLinks = [
  igdbPageUrl && { label: 'IGDB', href: igdbPageUrl, className: 'external-link igdb-link' },
  ignPageUrl && { label: 'IGN', href: ignPageUrl, className: 'external-link ign-link' },
  metacriticPageUrl && { label: 'Metacritic', href: metacriticPageUrl, className: 'external-link metacritic-link' },
  steamStoreUrl && { label: 'Steam', href: steamStoreUrl, className: 'external-link steam-link' },
  official_url && official_url !== steamStoreUrl && { label: 'Official', href: official_url, className: 'external-link official-link' },
].filter(Boolean) as Array<{ label: string; href: string; className: string }>;

const metaItems = [
  { label: 'Developer', value: studio },
  publisher && { label: 'Publisher', value: publisher },
  director && { label: 'Director', value: director },
  creator && { label: 'Creator', value: creator },
  writer && { label: 'Writer', value: writer },
  composer && { label: 'Composer', value: composer },
  author && { label: 'Author', value: author },
  { label: 'Source', value: sourceLabel },
  { label: 'Platform', value: platform },
  { label: 'Year', value: String(year) },
  { label: 'Genre', value: genre.split(',')[0] },
  playtime_hours != null && playtime_hours > 0 && { label: 'Playtime', value: `${playtime_hours}h`, highlight: true },
].filter(Boolean) as Array<{ label: string; value: string; highlight?: boolean }>;
---

<BaseLayout title={title} description={`${title} - ${genre}`} image={cover} activeNav="games">
  <a href={`${import.meta.env.BASE_URL}games/`} class="back-link">Back to Games</a>

  <div class="game-detail">
    <aside class="game-side">
      {cover ? (
        <img src={cover} alt={title} class="game-cover" onerror="this.hidden=true;this.nextElementSibling.hidden=false" />
      ) : null}
      <span class="detail-cover-fallback" hidden={Boolean(cover)}>{title.slice(0, 1)}</span>

      <nav class="external-links" aria-label="External game links">
        {externalLinks.map(link => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class={link.className}>
            {link.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
    </aside>

    <main class="game-main">
      <div class="badges">
        <span class="badge badge-game">Game</span>
        <span class="badge soft-badge">{statusLabels[status] || status}</span>
        <span class="badge soft-badge">Source: {sourceLabel}</span>
        <span class="badge soft-badge">{platform}</span>
      </div>

      <h1>{title}</h1>
      <p class="game-subtitle">{studio} · {year}</p>

      <section class="score-grid" aria-label="Game scores">
        <div class="score-panel" style={`--score-color:${scoreColor};`}>
          <p class="score-kicker">My Score</p>
          <div class="score-row">
            <div class="score-box">{rating > 0 ? rating : '—'}</div>
            <div>
              <p class="score-label">{scoreLabel}</p>
              <p class="score-genre">{genre}</p>
            </div>
          </div>
        </div>

        <div class="score-panel score-panel-secondary" style={`--score-color:${igdbScoreColor};`}>
          <p class="score-kicker">IGDB</p>
          <div class="score-row">
            <div class="score-box score-box-secondary">{igdb_score ? igdb_score.toFixed(1) : '—'}</div>
            <div>
              <p class="score-label">{igdbScoreLabel}</p>
              <p class="score-genre">Community score</p>
            </div>
          </div>
        </div>
      </section>

      <section class="meta-grid" aria-label="Game metadata">
        {metaItems.map(item => (
          <div class="meta-card">
            <p>{item.label}</p>
            <strong class={item.highlight ? 'highlight' : ''}>{item.value}</strong>
          </div>
        ))}
      </section>

      <div class="prose">
        <Content />
      </div>

      {date && (
        <p class="rated-date">
          Rated on {new Date(date).toLocaleDateString('vi-VN')}
        </p>
      )}
    </main>
  </div>

  {relatedPosts.length > 0 && (
    <section class="related-section">
      <p class="section-label">Bai viet lien quan</p>
      <hr class="section-divider" />
      <div class="post-list">
        {relatedPosts.map(post => (
          <a href={`${import.meta.env.BASE_URL}posts/${post.id}/`} class="post-card">
            <p class="post-title">{post.data.title}</p>
            {post.data.description && <p class="post-desc">{post.data.description}</p>}
            <div class="post-meta">
              <span>{new Date(post.data.date).toLocaleDateString('vi-VN')}</span>
              {post.data.tags?.map(tag => (
                <span class="post-tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .back-link {
    color: rgba(255, 255, 255, 0.45);
    display: inline-block;
    font-size: 13px;
    margin-bottom: 16px;
    text-decoration: none;
  }

  .back-link::before {
    content: '< ';
  }

  .game-detail {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .game-side {
    flex: 0 0 220px;
  }

  .game-cover {
    border-radius: 12px;
    display: block;
    width: 220px;
  }

  .external-links {
    display: grid;
    gap: 8px;
    margin-top: 14px;
  }

  .external-link {
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    display: flex;
    font-size: 12px;
    font-weight: 700;
    justify-content: center;
    min-height: 38px;
    padding: 8px 10px;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }

  .external-link:hover {
    transform: translateY(-1px);
  }

  .external-link span {
    margin-left: 6px;
  }

  .igdb-link {
    background: rgba(145, 71, 255, 0.16);
    border-color: rgba(145, 71, 255, 0.35);
    color: #b794ff;
  }

  .ign-link {
    background: rgba(191, 35, 42, 0.16);
    border-color: rgba(191, 35, 42, 0.35);
    color: #ff5d5d;
  }

  .metacritic-link {
    background: rgba(255, 204, 51, 0.13);
    border-color: rgba(255, 204, 51, 0.32);
    color: #ffd65a;
  }

  .steam-link {
    background: rgba(27, 40, 56, 0.55);
    border-color: rgba(102, 192, 244, 0.35);
    color: #66c0f4;
  }

  .official-link {
    background: rgba(52, 211, 153, 0.12);
    border-color: rgba(52, 211, 153, 0.3);
    color: #34d399;
  }

  .game-main {
    flex: 1;
    min-width: 280px;
  }

  .badges {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
  }

  .soft-badge {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-secondary);
  }

  h1 {
    font-size: 26px;
    font-weight: 700;
    margin: 0 0 4px;
  }

  .game-subtitle {
    color: var(--text-muted);
    font-size: 13px;
    margin: 0 0 20px;
  }

  .score-grid {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: 24px;
  }

  .score-panel {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    min-width: 0;
    padding: 16px 20px;
  }

  .score-panel-secondary {
    background: rgba(255, 255, 255, 0.025);
  }

  .score-kicker {
    color: var(--text-muted);
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.5px;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .score-row {
    align-items: center;
    display: flex;
    gap: 16px;
    min-width: 0;
  }

  .score-box {
    align-items: center;
    background: var(--score-color);
    border-radius: 12px;
    color: #0a0a14;
    display: flex;
    flex: 0 0 64px;
    font-family: 'Space Mono', monospace;
    font-size: 24px;
    font-weight: 800;
    height: 64px;
    justify-content: center;
  }

  .score-box-secondary {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--score-color);
    color: var(--score-color);
  }

  .score-label {
    color: var(--score-color);
    font-size: 18px;
    font-weight: 700;
    margin: 0;
  }

  .score-genre {
    color: var(--text-muted);
    font-size: 12px;
    margin: 2px 0 0;
    overflow-wrap: anywhere;
  }

  .meta-grid {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: 24px;
  }

  .meta-card {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 8px;
    padding: 10px 12px;
  }

  .meta-card p {
    color: var(--text-muted);
    font-size: 10px;
    letter-spacing: 0.5px;
    margin: 0;
    text-transform: uppercase;
  }

  .meta-card strong {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-top: 2px;
  }

  .meta-card .highlight {
    color: var(--game-color);
  }

  .rated-date {
    color: var(--text-muted);
    font-size: 11px;
    margin-top: 16px;
  }

  .related-section {
    margin-top: 40px;
  }

  @media (max-width: 640px) {
    .game-detail {
      gap: 18px;
    }

    .game-side {
      flex-basis: 100%;
    }

    .game-cover {
      max-width: 260px;
      width: 100%;
    }

    .external-links {
      max-width: 260px;
    }

    .score-grid {
      grid-template-columns: 1fr;
    }

    .meta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
