---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaCard from '../../components/MediaCard.astro';
import { getCollection } from 'astro:content';

const allFilms = (await getCollection('films')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const top10 = [...allFilms].sort((a, b) => b.data.rating - a.data.rating).slice(0, 10);
const genres = [...new Set(allFilms.flatMap(f => f.data.genre.split(',').map(g => g.trim())).filter(Boolean))].sort();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Films" activeNav="films">
  {/* Top 10 */}
  <section class="reveal" style="margin-bottom: 32px;">
    <p class="section-label">Top 10 — Điểm cao nhất</p>
    <hr class="section-divider" />
    <div class="top-carousel">
      {top10.map((item, i) => (
        <a href={`${base}films/${item.id}/`} class="top-card" data-type="film">
          <span class="top-rank">#{i + 1}</span>
          <span class="cover-fallback">{item.data.title.slice(0, 1)}</span>
          {item.data.cover && <img src={item.data.cover} alt={item.data.title} loading="lazy" onerror="this.hidden=true" />}
          <div class="top-overlay">
            <p class="top-title">{item.data.title}</p>
            <div class="top-scores">
              <span class="top-score" style="color: var(--film-color);">{item.data.rating}<small>/10</small></span>
              {item.data.imdb_score && <span class="top-score-sub">IMDB {item.data.imdb_score}</span>}
              {item.data.tmdb_score && <span class="top-score-sub">TMDB {item.data.tmdb_score}</span>}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* Search + Filter */}
  <section style="margin-bottom: 24px;">
    <div class="filter-bar">
      <input type="text" id="search" class="filter-input" placeholder="Tìm film..." autocomplete="off" />
      <select id="genre-filter" class="filter-select">
        <option value="">Tất cả thể loại</option>
        {genres.map(g => <option value={g}>{g}</option>)}
      </select>
      <select id="status-filter" class="filter-select">
        <option value="">Tất cả trạng thái</option>
        <option value="watched">Đã xem</option>
        <option value="plan">Dự định</option>
      </select>
      <select id="source-filter" class="filter-select">
        <option value="">All sources</option>
        <option value="movie">TMDB Movie</option>
        <option value="tv">TMDB TV</option>
        <option value="imdb">Has IMDb</option>
        <option value="tmdb">Has TMDB</option>
      </select>
      <select id="sort-filter" class="filter-select">
        <option value="rating">My Score ↓</option>
        <option value="date">Mới nhất</option>
        <option value="imdb">IMDB Score ↓</option>
        <option value="tmdb">TMDB Score ↓</option>
        <option value="title">A → Z</option>
        <option value="year">Năm ↓</option>
      </select>
    </div>
    <div class="quick-filters" aria-label="Quick film filters">
      <button type="button" class="quick-filter active" data-quick="">All</button>
      <button type="button" class="quick-filter" data-quick="watched">Watched</button>
      <button type="button" class="quick-filter" data-quick="plan">Plan</button>
      <button type="button" class="quick-filter" data-quick="top">Top Rated</button>
      <button type="button" class="quick-filter" data-quick="missing-cover">Missing Cover</button>
    </div>
    <p class="section-label" style="margin-top: 16px;">
      Bộ sưu tập Film — <span id="count">{allFilms.length}</span> tựa
    </p>
  </section>

  <div class="media-grid" id="media-grid">
    {allFilms.map((item, i) => (
      <div class="filter-item"
        data-title={item.data.title.toLowerCase()}
        data-genre={item.data.genre.toLowerCase()}
        data-status={item.data.status}
        data-rating={item.data.rating}
        data-imdb={item.data.imdb_score || 0}
        data-tmdb={item.data.tmdb_score || 0}
        data-tmdb-type={item.data.tmdb_type || ''}
        data-has-imdb={item.data.imdb_id ? 'true' : 'false'}
        data-has-tmdb={item.data.tmdb_id ? 'true' : 'false'}
        data-has-cover={item.data.cover ? 'true' : 'false'}
        data-year={item.data.year}
        data-date={new Date(item.data.date).getTime()}>
        <MediaCard
          title={item.data.title}
          type="film"
          rating={item.data.rating}
          genre={item.data.genre}
          year={item.data.year}
          cover={item.data.cover}
          status={item.data.status}
          slug={item.id}
          index={i}
        />
      </div>
    ))}
  </div>

  <script>
    function initFilters() {
      const search = document.getElementById('search') as HTMLInputElement;
      const genre = document.getElementById('genre-filter') as HTMLSelectElement;
      const status = document.getElementById('status-filter') as HTMLSelectElement;
      const source = document.getElementById('source-filter') as HTMLSelectElement;
      const sort = document.getElementById('sort-filter') as HTMLSelectElement;
      const quickButtons = [...document.querySelectorAll('.quick-filter')] as HTMLButtonElement[];
      const grid = document.getElementById('media-grid');
      const count = document.getElementById('count');
      if (!search || !genre || !status || !source || !sort || !grid || !count) return;
      let quick = '';

      function apply() {
        const q = search.value.toLowerCase();
        const g = genre.value.toLowerCase();
        const s = status.value;
        const sourceValue = source.value;
        const items = [...grid.querySelectorAll('.filter-item')] as HTMLElement[];
        const sv = sort.value;
        items.sort((a, b) => {
          if (sv === 'rating') return parseFloat(b.dataset.rating!) - parseFloat(a.dataset.rating!);
          if (sv === 'imdb') return parseFloat(b.dataset.imdb!) - parseFloat(a.dataset.imdb!);
          if (sv === 'tmdb') return parseFloat(b.dataset.tmdb!) - parseFloat(a.dataset.tmdb!);
          if (sv === 'title') return a.dataset.title!.localeCompare(b.dataset.title!);
          if (sv === 'year') return parseInt(b.dataset.year!) - parseInt(a.dataset.year!);
          return parseFloat(b.dataset.date!) - parseFloat(a.dataset.date!);
        });
        items.forEach(el => grid.appendChild(el));
        let v = 0;
        items.forEach(el => {
          const sourceOk = !sourceValue ||
            (sourceValue === 'movie' && el.dataset.tmdbType === 'movie') ||
            (sourceValue === 'tv' && el.dataset.tmdbType === 'tv') ||
            (sourceValue === 'imdb' && el.dataset.hasImdb === 'true') ||
            (sourceValue === 'tmdb' && el.dataset.hasTmdb === 'true');
          const quickOk = !quick ||
            (quick === 'watched' && el.dataset.status === 'watched') ||
            (quick === 'plan' && el.dataset.status === 'plan') ||
            (quick === 'top' && parseFloat(el.dataset.rating || '0') >= 9) ||
            (quick === 'missing-cover' && el.dataset.hasCover !== 'true');
          const ok = (!q || el.dataset.title!.includes(q)) &&
                     (!g || el.dataset.genre!.includes(g)) &&
                     (!s || el.dataset.status === s) &&
                     sourceOk &&
                     quickOk;
          el.style.display = ok ? '' : 'none';
          if (ok) v++;
        });
        count.textContent = String(v);
      }
      search.addEventListener('input', apply);
      genre.addEventListener('change', apply);
      status.addEventListener('change', apply);
      source.addEventListener('change', apply);
      sort.addEventListener('change', apply);
      quickButtons.forEach(button => {
        button.addEventListener('click', () => {
          quick = button.dataset.quick || '';
          quickButtons.forEach(item => item.classList.toggle('active', item === button));
          apply();
        });
      });
    }
    initFilters();
    document.addEventListener('astro:after-swap', initFilters);
  </script>
</BaseLayout>
