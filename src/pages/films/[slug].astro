---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { postMatchesMedia } from '../../lib/mediaRelations';

export async function getStaticPaths() {
  const films = await getCollection('films');
  return films.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const allPosts = (await getCollection('posts')).filter(p => !p.data.draft);
const { entry } = Astro.props;
const {
  title,
  imdb_id,
  tmdb_id,
  tmdb_type,
  rating,
  imdb_score,
  tmdb_score,
  genre,
  year,
  director,
  creator,
  writer,
  composer,
  author,
  status,
  cover,
  date,
} = entry.data;

const relatedPosts = allPosts.filter(post => postMatchesMedia(post, 'films', entry.id));
const myStars = Math.round(rating / 2);
const imdbStars = Math.round((imdb_score || 0) / 2);
const tmdbStars = Math.round((tmdb_score || 0) / 2);

const imdbUrl = imdb_id
  ? `https://www.imdb.com/title/${imdb_id}`
  : `https://www.imdb.com/find/?q=${encodeURIComponent(title)}`;
const tmdbUrl = tmdb_id
  ? `https://www.themoviedb.org/${tmdb_type === 'tv' ? 'tv' : 'movie'}/${tmdb_id}`
  : `https://www.themoviedb.org/search?query=${encodeURIComponent(title)}`;

const metaItems = [
  { label: 'Source', value: tmdb_id ? 'TMDB' : 'Manual' },
  { label: 'Director', value: director },
  creator && { label: 'Creator', value: creator },
  writer && { label: 'Writer', value: writer },
  composer && { label: 'Composer', value: composer },
  author && { label: 'Author', value: author },
  { label: 'Year', value: String(year) },
  { label: 'Genre', value: genre },
].filter(Boolean) as Array<{ label: string; value: string }>;
---

<BaseLayout title={title} description={`${title} — ${genre}`} image={cover} activeNav="films">
  <section class="media-detail-shell media-detail-film" style={cover ? `--detail-image: url("${cover}")` : undefined}>
    <a href={`${import.meta.env.BASE_URL}films/`} class="detail-back">Back to Films</a>

    <div class="media-detail-grid">
      <aside class="detail-side">
        {cover ? (
          <img src={cover} alt={title} class="detail-cover" onerror="this.hidden=true;this.nextElementSibling.hidden=false" />
        ) : null}
        <span class="detail-cover-fallback" hidden={Boolean(cover)}>{title.slice(0, 1)}</span>

        <nav class="detail-actions" aria-label="External film links">
          <a href={imdbUrl} target="_blank" rel="noopener noreferrer" class="detail-action imdb">
            {imdb_id ? 'View on IMDB' : 'Search on IMDB'}
          </a>
          <a href={tmdbUrl} target="_blank" rel="noopener noreferrer" class="detail-action tmdb">
            {tmdb_id ? 'View on TMDB' : 'Search on TMDB'}
          </a>
        </nav>
      </aside>

      <main class="detail-main">
        <div class="detail-badges">
          <span class="badge badge-film">Film</span>
          <span class="badge soft-badge">{status === 'watched' ? 'Watched' : 'Plan to Watch'}</span>
          <span class="badge soft-badge">Source: {tmdb_id ? 'TMDB' : 'Manual'}</span>
        </div>

        <h1 class="detail-title">{title}</h1>
        <p class="detail-subtitle">{genre} - {year} - {director}</p>

        <section class="detail-score-grid three" aria-label="Film scores">
          <div class="detail-score-card">
            <p>My Score</p>
            <span class="detail-score-value" style="color:var(--star-color);">{rating > 0 ? rating : '-'}</span>
            <div class="stars">
              {[...Array(5)].map((_, i) => (
                <span class={i < myStars ? 'star-on' : 'star-off'}>&#9733;</span>
              ))}
            </div>
          </div>
          <div class="detail-score-card">
            <p>IMDB</p>
            <span class="detail-score-value" style="color:#F5C518;">{imdb_score ? imdb_score.toFixed(1) : '-'}</span>
            <div class="stars">
              {[...Array(5)].map((_, i) => (
                <span class={i < imdbStars ? 'star-on' : 'star-off'}>&#9733;</span>
              ))}
            </div>
          </div>
          <div class="detail-score-card">
            <p>TMDB</p>
            <span class="detail-score-value" style="color:#01B4E4;">{tmdb_score ? tmdb_score.toFixed(1) : '-'}</span>
            <div class="stars">
              {[...Array(5)].map((_, i) => (
                <span class={i < tmdbStars ? 'star-on' : 'star-off'}>&#9733;</span>
              ))}
            </div>
          </div>
        </section>

        <section class="detail-meta-grid" aria-label="Film metadata">
          {metaItems.map(item => (
            <div class={`detail-meta-card ${item.label === 'Genre' ? 'wide' : ''}`}>
              <p>{item.label}</p>
              <strong>{item.value}</strong>
            </div>
          ))}
        </section>

        {date && (
          <p class="detail-date">Rated on {new Date(date).toLocaleDateString('vi-VN')}</p>
        )}
      </main>
    </div>
  </section>

  {relatedPosts.length > 0 && (
    <section style="margin-top: 40px;">
      <p class="section-label">Bài viết liên quan</p>
      <hr class="section-divider" />
      <div class="post-list">
        {relatedPosts.map(post => (
          <a href={`${import.meta.env.BASE_URL}posts/${post.id}/`} class="post-card">
            <p class="post-title">{post.data.title}</p>
            {post.data.description && <p class="post-desc">{post.data.description}</p>}
            <div class="post-meta">
              <span>{new Date(post.data.date).toLocaleDateString('vi-VN')}</span>
              {post.data.tags?.map(tag => (
                <span class="post-tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
