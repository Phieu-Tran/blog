---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { postMatchesMedia } from '../../lib/mediaRelations';

export async function getStaticPaths() {
  const anime = await getCollection('anime');
  return anime.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const allPosts = (await getCollection('posts')).filter(p => !p.data.draft);
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const {
  title,
  mal_id,
  rating,
  mal_score,
  genre,
  year,
  studio,
  director,
  creator,
  writer,
  composer,
  author,
  status,
  episodes_watched,
  episodes_total,
  episodes,
  cover,
  updated_at,
  date,
} = entry.data;

const relatedPosts = allPosts.filter(post => postMatchesMedia(post, 'anime', entry.id));
const ogImage = `${base}og/anime/${entry.id}.svg`;
const lastUpdated = updated_at || date;
const myStars = Math.round(rating / 2);
const malStars = Math.round((mal_score || 0) / 2);
const totalEps = episodes_total || episodes || 0;
const watchedEps = episodes_watched || 0;
const progress = totalEps > 0 ? Math.round((watchedEps / totalEps) * 100) : 0;
const malUrl = mal_id ? `https://myanimelist.net/anime/${mal_id}` : null;

const statusLabels: Record<string, string> = {
  watching: 'Watching', completed: 'Completed', plan: 'Plan to Watch', dropped: 'Dropped',
};
const statusColors: Record<string, string> = {
  watching: 'var(--game-color)', completed: 'var(--anime-color)', plan: 'var(--text-muted)', dropped: '#EF4444',
};

const metaItems = [
  { label: 'Source', value: mal_id ? 'MAL' : 'Manual' },
  { label: 'Studio', value: studio },
  director && { label: 'Director', value: director },
  creator && { label: 'Creator', value: creator },
  writer && { label: 'Writer', value: writer },
  composer && { label: 'Composer', value: composer },
  author && { label: 'Author', value: author },
  { label: 'Year', value: String(year) },
  { label: 'Episodes', value: totalEps ? String(totalEps) : '?' },
  { label: 'Genre', value: genre.split(',')[0] },
].filter(Boolean) as Array<{ label: string; value: string }>;
---

<BaseLayout title={title} description={`${title} — ${genre}`} image={ogImage} activeNav="anime">
  <section class="media-detail-shell media-detail-anime" style={cover ? `--detail-image: url("${cover}")` : undefined}>
    <a href={`${base}anime/`} class="detail-back">Back to Anime</a>

    <div class="media-detail-grid">
      <aside class="detail-side">
        {cover ? (
          <img src={cover} alt={title} class="detail-cover" onerror="this.hidden=true;this.nextElementSibling.hidden=false" />
        ) : null}
        <span class="detail-cover-fallback" hidden={Boolean(cover)}>{title.slice(0, 1)}</span>

        {malUrl && (
          <nav class="detail-actions" aria-label="External anime links">
            <a href={malUrl} target="_blank" rel="noopener noreferrer" class="detail-action mal">
              View on MyAnimeList
            </a>
          </nav>
        )}
      </aside>

      <main class="detail-main">
        <div class="detail-badges">
          <span class="badge badge-anime">Anime</span>
          <span class="badge soft-badge" style={`color:${statusColors[status]};`}>{statusLabels[status]}</span>
          <span class="badge soft-badge">Source: {mal_id ? 'MAL' : 'Manual'}</span>
        </div>

        <h1 class="detail-title">{title}</h1>
        <p class="detail-subtitle">{genre} - {year} - {studio}</p>

        <section class="detail-score-grid" aria-label="Anime scores">
          <div class="detail-score-card">
            <p>My Score</p>
            <span class="detail-score-value" style="color:var(--star-color);">{rating > 0 ? rating : '-'}</span>
            <div class="stars">
              {[...Array(5)].map((_, i) => (
                <span class={i < myStars ? 'star-on' : 'star-off'}>&#9733;</span>
              ))}
            </div>
          </div>
          <div class="detail-score-card">
            <p>MAL Score</p>
            <span class="detail-score-value" style="color:var(--anime-color);">{mal_score ? mal_score.toFixed(2) : '-'}</span>
            <div class="stars">
              {[...Array(5)].map((_, i) => (
                <span class={i < malStars ? 'star-on' : 'star-off'}>&#9733;</span>
              ))}
            </div>
          </div>
        </section>

        {totalEps > 0 && (
          <section class="detail-progress" aria-label="Episode progress">
            <div class="detail-progress-head">
              <span>Progress</span>
              <strong>{watchedEps} / {totalEps} eps</strong>
            </div>
            <div class="detail-progress-track">
              <div class="detail-progress-fill" style={`width:${progress}%;`}></div>
            </div>
          </section>
        )}

        <section class="detail-meta-grid" aria-label="Anime metadata">
          {metaItems.map(item => (
            <div class={`detail-meta-card ${item.label === 'Genre' ? 'wide' : ''}`}>
              <p>{item.label}</p>
              <strong>{item.value}</strong>
            </div>
          ))}
        </section>

        {lastUpdated && (
          <p class="detail-date">Last updated {new Date(lastUpdated).toLocaleDateString('vi-VN')}</p>
        )}
      </main>
    </div>
  </section>

  {/* Related Posts */}
  {relatedPosts.length > 0 && (
    <section style="margin-top: 40px;">
      <p class="section-label">Bài viết liên quan</p>
      <hr class="section-divider" />
      <div class="post-list">
        {relatedPosts.map(post => (
          <a href={`${base}posts/${post.id}/`} class="post-card">
            <p class="post-title">{post.data.title}</p>
            {post.data.description && <p class="post-desc">{post.data.description}</p>}
            <div class="post-meta">
              <span>{new Date(post.data.date).toLocaleDateString('vi-VN')}</span>
              {post.data.tags?.map(tag => (
                <span class="post-tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
