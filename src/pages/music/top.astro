---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Written by sync-spotify (needs the user-top-read scope); optional so the site builds before the first sync.
type TopTrack = { id: string; name: string; artists: string; album?: string; cover?: string; prev?: number | null };
type TopArtist = { id: string; name: string; image?: string; genres: string[]; prev?: number | null };
type TopData = {
  updated: string;
  previous_updated?: string;
  tracks: Record<string, TopTrack[]>;
  artists: Record<string, TopArtist[]>;
};
const files = import.meta.glob<{ default: TopData }>('../../data/spotify-top.json', { eager: true });
const top = Object.values(files)[0]?.default;
const base = import.meta.env.BASE_URL;

const ranges = [
  { key: 'short_term', label: '4 tuần' },
  { key: 'medium_term', label: '6 tháng' },
  { key: 'long_term', label: '12 tháng' },
] as const;

// Genres: weight each top artist's genres by rank (#1 counts 50, #50 counts 1).
const genresFor = (artists: TopArtist[]) => {
  const scores = new Map<string, number>();
  artists.forEach((artist, i) => artist.genres.forEach(g => scores.set(g, (scores.get(g) || 0) + (artists.length - i))));
  const list = [...scores.entries()].sort((a, b) => b[1] - a[1]).slice(0, 15);
  const max = Math.max(1, ...list.map(([, s]) => s));
  return list.map(([name, score]) => ({ name: name.replace(/\b\w/g, c => c.toUpperCase()), pct: (score / max) * 100 }));
};

const change = (rank: number, prev?: number | null) => {
  if (prev === undefined) return { cls: '', text: '' };
  if (prev === null) return { cls: 'new', text: 'Mới' };
  if (prev === rank) return { cls: 'same', text: '–' };
  return prev > rank ? { cls: 'up', text: `↑${prev - rank}` } : { cls: 'down', text: `↓${rank - prev}` };
};
const fmtDate = (iso?: string) => (iso ? new Date(iso).toLocaleDateString('vi-VN') : '');
---

<BaseLayout title="Top nghe nhiều" description="Bài hát, nghệ sĩ và thể loại mình nghe nhiều nhất trên Spotify" activeNav="music">
  <a href={`${base}music/`} class="detail-back">Về kệ nhạc</a>
  <header class="top-head">
    <p class="section-label">Spotify</p>
    <h1>Top nghe nhiều</h1>
    {top && (
      <p class="top-meta">
        Cập nhật {fmtDate(top.updated)}{top.previous_updated && <> · mũi tên so với {fmtDate(top.previous_updated)}</>}
      </p>
    )}
  </header>

  {!top ? (
    <section class="books-empty music-theme">
      <p class="books-empty-title">Chưa có dữ liệu top</p>
      <p class="books-empty-desc">Dữ liệu sẽ có sau lần sync Spotify đầu tiên.</p>
    </section>
  ) : (
    <section class="top-board" data-kind="tracks" data-range="short_term">
      <div class="top-controls">
        <div class="top-tabs" role="tablist" aria-label="Loại">
          <button type="button" class="top-tab active" data-set-kind="tracks" role="tab" aria-selected="true">Bài hát</button>
          <button type="button" class="top-tab" data-set-kind="artists" role="tab" aria-selected="false">Nghệ sĩ</button>
          <button type="button" class="top-tab" data-set-kind="genres" role="tab" aria-selected="false">Thể loại</button>
        </div>
        <div class="top-ranges" role="tablist" aria-label="Khoảng thời gian">
          {ranges.map((range, i) => (
            <button type="button" class={`top-range ${i === 0 ? 'active' : ''}`} data-set-range={range.key} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>{range.label}</button>
          ))}
        </div>
      </div>

      {ranges.map(range => (
        <>
          <ol class="top-tracks" data-panel="tracks" data-for={range.key}>
            {(top.tracks[range.key] || []).map((track, i) => {
              const c = change(i + 1, track.prev);
              return (
                <li>
                  <a href={`https://open.spotify.com/track/${track.id}`} target="_blank" rel="noopener noreferrer" class="top-track">
                    <span class="top-rank-no">{i + 1}</span>
                    <span class="top-track-cover">{track.cover && <img src={track.cover} alt="" loading="lazy" decoding="async" />}</span>
                    <span class="top-track-copy">
                      <strong>{track.name}</strong>
                      <small>{track.artists}{track.album ? ` · ${track.album}` : ''}</small>
                    </span>
                    {c.text && <span class={`top-change ${c.cls}`}>{c.text}</span>}
                  </a>
                </li>
              );
            })}
          </ol>

          <ol class="top-artists" data-panel="artists" data-for={range.key}>
            {(top.artists[range.key] || []).map((artist, i) => {
              const c = change(i + 1, artist.prev);
              return (
                <li>
                  <a href={`https://open.spotify.com/artist/${artist.id}`} target="_blank" rel="noopener noreferrer" class="top-artist">
                    <span class="top-artist-img">
                      <span>{artist.name.slice(0, 1)}</span>
                      {artist.image && <img src={artist.image} alt="" loading="lazy" decoding="async" />}
                    </span>
                    <strong>{i + 1}. {artist.name}</strong>
                    {c.text && <span class={`top-change ${c.cls}`}>{c.text}</span>}
                  </a>
                </li>
              );
            })}
          </ol>

          <ul class="top-genres" data-panel="genres" data-for={range.key}>
            {genresFor(top.artists[range.key] || []).length === 0 ? (
              <li class="top-genres-empty">Spotify không trả về thể loại cho các nghệ sĩ này.</li>
            ) : genresFor(top.artists[range.key] || []).map((genre, i) => (
              <li class="top-genre">
                <span class="top-genre-name">{i + 1}. {genre.name}</span>
                <span class="top-genre-track"><span style={`width: ${genre.pct}%`}></span></span>
              </li>
            ))}
          </ul>
        </>
      ))}
    </section>
  )}
</BaseLayout>

<script>
  function initTopBoard() {
    const board = document.querySelector<HTMLElement>('.top-board');
    if (!board || board.dataset.bound === 'true') return;
    board.dataset.bound = 'true';
    const select = (attr: 'kind' | 'range', value: string) => {
      board.dataset[attr] = value;
      const selector = attr === 'kind' ? '[data-set-kind]' : '[data-set-range]';
      board.querySelectorAll<HTMLButtonElement>(selector).forEach(btn => {
        const on = (attr === 'kind' ? btn.dataset.setKind : btn.dataset.setRange) === value;
        btn.classList.toggle('active', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    };
    board.querySelectorAll<HTMLButtonElement>('[data-set-kind]').forEach(btn => btn.addEventListener('click', () => select('kind', btn.dataset.setKind!)));
    board.querySelectorAll<HTMLButtonElement>('[data-set-range]').forEach(btn => btn.addEventListener('click', () => select('range', btn.dataset.setRange!)));
  }
  initTopBoard();
  document.addEventListener('astro:page-load', initTopBoard);
</script>

<style>
  .top-head { margin: 4px 0 22px; text-align: center; }
  .top-head h1 { font-size: clamp(28px, 4.5vw, 42px); font-weight: 800; margin: 4px 0 6px; }
  .top-meta { color: var(--text-muted); font-size: 13px; }

  .top-controls {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    display: grid;
    gap: 8px;
    margin: 0 auto 22px;
    max-width: 640px;
    padding: 8px;
  }
  .top-tabs, .top-ranges { display: grid; gap: 6px; grid-template-columns: repeat(3, 1fr); }
  .top-tab, .top-range {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: var(--text-secondary);
    cursor: pointer;
    font: inherit;
    padding: 9px 6px;
  }
  .top-tab { font-size: 14px; font-weight: 600; }
  .top-range { font-size: 12px; }
  .top-tab.active, .top-range.active {
    background: rgba(30, 215, 96, 0.1);
    border-color: rgba(30, 215, 96, 0.35);
    color: #1ED760;
  }

  /* Only the panel matching the selected kind + range is visible. */
  [data-panel] { display: none; }
  .top-board[data-kind="tracks"][data-range="short_term"] [data-panel="tracks"][data-for="short_term"],
  .top-board[data-kind="tracks"][data-range="medium_term"] [data-panel="tracks"][data-for="medium_term"],
  .top-board[data-kind="tracks"][data-range="long_term"] [data-panel="tracks"][data-for="long_term"] { display: grid; }
  .top-board[data-kind="artists"][data-range="short_term"] [data-panel="artists"][data-for="short_term"],
  .top-board[data-kind="artists"][data-range="medium_term"] [data-panel="artists"][data-for="medium_term"],
  .top-board[data-kind="artists"][data-range="long_term"] [data-panel="artists"][data-for="long_term"] { display: grid; }
  .top-board[data-kind="genres"][data-range="short_term"] [data-panel="genres"][data-for="short_term"],
  .top-board[data-kind="genres"][data-range="medium_term"] [data-panel="genres"][data-for="medium_term"],
  .top-board[data-kind="genres"][data-range="long_term"] [data-panel="genres"][data-for="long_term"] { display: grid; }

  .top-tracks, .top-artists, .top-genres { list-style: none; margin: 0; padding: 0; }
  .top-tracks { gap: 6px; margin: 0 auto; max-width: 820px; }
  .top-track {
    align-items: center;
    border-radius: 10px;
    color: var(--text-primary);
    display: grid;
    gap: 12px;
    grid-template-columns: 28px 48px minmax(0, 1fr) auto;
    padding: 6px 10px;
  }
  .top-track:hover { background: rgba(255, 255, 255, 0.04); }
  .top-rank-no { color: var(--text-muted); font-family: 'Space Mono', monospace; font-size: 13px; text-align: right; }
  .top-track-cover { aspect-ratio: 1; background: #1a1a2e; border-radius: 6px; overflow: hidden; }
  .top-track-cover img { display: block; height: 100%; object-fit: cover; width: 100%; }
  .top-track-copy { display: grid; gap: 2px; min-width: 0; }
  .top-track-copy strong, .top-track-copy small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .top-track-copy strong { font-size: 14px; }
  .top-track-copy small { color: var(--text-muted); font-size: 12px; }

  .top-artists { gap: 14px; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .top-artist { color: var(--text-primary); display: grid; gap: 8px; justify-items: center; position: relative; text-align: center; }
  .top-artist-img {
    aspect-ratio: 1;
    background: #1a1a2e;
    border-radius: 12px;
    display: grid;
    overflow: hidden;
    place-items: center;
    position: relative;
    width: 100%;
  }
  .top-artist-img span { color: rgba(255, 255, 255, 0.4); font-size: 32px; font-weight: 800; }
  .top-artist-img img { height: 100%; inset: 0; object-fit: cover; position: absolute; transition: transform 0.4s ease; width: 100%; }
  .top-artist:hover .top-artist-img img { transform: scale(1.05); }
  .top-artist strong { font-size: 13px; }
  .top-artist .top-change { position: absolute; right: 6px; top: 6px; }

  .top-change {
    background: rgba(0, 0, 0, 0.55);
    border-radius: 6px;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    padding: 2px 6px;
  }
  .top-change.up { color: #1ED760; }
  .top-change.down { color: #FF6B81; }
  .top-change.same { color: var(--text-muted); }
  .top-change.new { color: var(--music-color); }

  .top-genres { gap: 8px; margin: 0 auto; max-width: 720px; }
  .top-genre { align-items: center; display: grid; gap: 12px; grid-template-columns: minmax(0, 200px) 1fr; }
  .top-genre-name { font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .top-genre-track { background: rgba(255, 255, 255, 0.05); border-radius: 999px; height: 10px; overflow: hidden; }
  .top-genre-track span { background: #1ED760; border-radius: 999px; display: block; height: 100%; }
  .top-genres-empty { color: var(--text-muted); font-size: 14px; text-align: center; }

  @media (max-width: 600px) {
    .top-artists { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .top-genre { grid-template-columns: minmax(0, 120px) 1fr; }
  }
</style>
