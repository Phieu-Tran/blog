---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShelfCard from '../components/ShelfCard.astro';
import { getCollection } from 'astro:content';
import { firstMarkdownImage } from '../lib/mediaRelations';
import '../styles/home.css';

const allAnime = await getCollection('anime');
const allGames = await getCollection('games');
const allFilms = await getCollection('films');
const allBooks = await getCollection('books');
const allPosts = (await getCollection('posts')).filter(p => !p.data.draft);
const base = import.meta.env.BASE_URL;

const byDate = <T extends { data: { date: Date } }>(list: T[]) =>
  [...list].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const byRating = <T extends { data: { rating: number; date: Date } }>(list: T[]) =>
  [...list].sort((a, b) => b.data.rating - a.data.rating || new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const SHELF_SIZE = 16;

// ─── Currently active (watching / playing / reading) ───
type ActiveItem = {
  collection: 'anime' | 'games' | 'books';
  slug: string;
  title: string;
  cover?: string;
  label: string;
  detail?: string;
  progress?: number;
  time: number;
};
const activeTime = (data: { updated_at?: Date; date: Date }) =>
  new Date(data.updated_at || data.date).getTime();
const active: ActiveItem[] = [
  ...allAnime.filter(a => a.data.status === 'watching').map(a => {
    const watched = a.data.episodes_watched || 0;
    const total = a.data.episodes_total || a.data.episodes || 0;
    return {
      collection: 'anime' as const, slug: a.id, title: a.data.title, cover: a.data.cover,
      label: 'Đang xem',
      detail: total ? `Tập ${watched}/${total}` : watched ? `Tập ${watched}` : undefined,
      progress: total ? Math.min(100, Math.round((watched / total) * 100)) : undefined,
      time: activeTime(a.data),
    };
  }),
  ...allGames.filter(g => g.data.status === 'playing').map(g => ({
    collection: 'games' as const, slug: g.id, title: g.data.title, cover: g.data.cover,
    label: 'Đang chơi',
    detail: g.data.playtime_hours ? `${g.data.playtime_hours} giờ` : undefined,
    time: activeTime(g.data as { date: Date }),
  })),
  ...allBooks.filter(b => b.data.status === 'reading').map(b => ({
    collection: 'books' as const, slug: b.id, title: b.data.title, cover: b.data.cover,
    label: 'Đang đọc',
    detail: b.data.author,
    time: activeTime(b.data),
  })),
].sort((a, b) => b.time - a.time);

// ─── Featured posts: newest first, the lead one gets the big card ───
const featuredPosts = byDate(allPosts).slice(0, 3).map(post => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags || [],
  date: post.data.date,
  image: post.data.cover || firstMarkdownImage(post.body),
}));

// ─── Shelves ───
const shelves = [
  {
    key: 'anime', label: 'Anime', href: 'anime/', count: allAnime.length, color: 'var(--anime-color)',
    recent: byDate(allAnime).slice(0, SHELF_SIZE), top: byRating(allAnime).slice(0, SHELF_SIZE),
    meta: (e: (typeof allAnime)[number]) => `${e.data.genre.split(',')[0]} — ${e.data.year}`,
  },
  {
    key: 'games', label: 'Games', href: 'games/', count: allGames.length, color: 'var(--game-color)',
    recent: byDate(allGames).slice(0, SHELF_SIZE), top: byRating(allGames).slice(0, SHELF_SIZE),
    meta: (e: (typeof allGames)[number]) => `${e.data.genre.split(',')[0]} — ${e.data.year}`,
  },
  {
    key: 'films', label: 'Films', href: 'films/', count: allFilms.length, color: 'var(--film-color)',
    recent: byDate(allFilms).slice(0, SHELF_SIZE), top: byRating(allFilms).slice(0, SHELF_SIZE),
    meta: (e: (typeof allFilms)[number]) => `${e.data.genre.split(',')[0]} — ${e.data.year}`,
  },
  {
    key: 'books', label: 'Sách', href: 'books/', count: allBooks.length, color: 'var(--book-color)',
    recent: byDate(allBooks).slice(0, SHELF_SIZE), top: byRating(allBooks).slice(0, SHELF_SIZE),
    meta: (e: (typeof allBooks)[number]) => `${e.data.author} — ${e.data.year}`,
  },
] as const;

// ─── Handpicked crowd covers ───
// Back row: remaining covers (smaller, blurred)
const crowdBack = [
  { cover: 'https://cdn.myanimelist.net/images/anime/2/73862.jpg', label: 'Mushi-Shi' },
  { cover: 'https://cdn.myanimelist.net/images/anime/1208/94745.jpg', label: 'FMA:B' },
  { cover: 'https://cdn.myanimelist.net/images/anime/4/19644.jpg', label: 'Cowboy Bebop' },
  { cover: 'https://cdn.myanimelist.net/images/anime/1314/108941.jpg', label: 'Evangelion' },
  { cover: 'https://cdn.myanimelist.net/images/anime/4/75509.jpg', label: 'Another' },
  { cover: 'https://image.tmdb.org/t/p/w500/yQvGrMoipbRoddT0ZR8tPoR7NfX.jpg', label: 'Interstellar' },
  { cover: 'https://image.tmdb.org/t/p/w500/gDzOcq0pfeCeqMBwKIJlSmQpjkZ.jpg', label: 'Dune' },
  { cover: 'https://image.tmdb.org/t/p/w500/191nKfP0ehp3uIvWqgPbFmI4lv9.jpg', label: 'Se7en' },
  { cover: 'https://images.igdb.com/igdb/image/upload/t_cover_big/co95gk.jpg', label: 'Elden Ring' },
  { cover: 'https://images.igdb.com/igdb/image/upload/t_cover_big/co2wn5.jpg', label: 'RE4' },
  { cover: 'https://steamcdn-a.akamaihd.net/steam/apps/632470/header.jpg', label: 'Disco Elysium' },
  { cover: 'https://images.igdb.com/igdb/image/upload/t_cover_big/cob9k6.jpg', label: 'FF7 Rebirth' },
];

// Front row: Akira + Sekiro + characters (sharp, larger, prominent)
const crowdFront = [
  { cover: `${import.meta.env.BASE_URL}crowd/akira.webp`, label: 'Akira' },
  { cover: `${import.meta.env.BASE_URL}crowd/sekiro.webp`, label: 'Sekiro' },
  { cover: `${import.meta.env.BASE_URL}crowd/leon.webp`, label: 'Leon S. Kennedy' },
  { cover: `${import.meta.env.BASE_URL}crowd/ada-wong.webp`, label: 'Ada Wong' },
  { cover: `${import.meta.env.BASE_URL}crowd/joker.webp`, label: 'The Joker' },
  { cover: `${import.meta.env.BASE_URL}crowd/knight.webp`, label: 'The Knight' },
  { cover: `${import.meta.env.BASE_URL}crowd/hornet.webp`, label: 'Hornet' },
];

const projects = [
  { name: 'Phieu.work', desc: 'Personal media hub — anime, games, films, sách', url: 'https://github.com/Phieu-Tran', badge: 'Live', badgeClass: 'badge-game' },
  { name: 'ClipPaste', desc: 'Clipboard manager tool', url: 'https://github.com/Phieu-Tran/ClipPaste', badge: 'WIP', badgeClass: 'badge-anime' },
];

const socials = [
  { name: 'GitHub', url: 'https://github.com/Phieu-Tran', icon: 'github' },
  { name: 'Instagram', url: 'https://www.instagram.com/tran_phuc_hieu?igsh=OTV5NWwyMmx3dzBi&utm_source=qr', icon: 'instagram' },
  { name: 'Facebook', url: 'https://www.facebook.com/T.Phuc.Hieu/', icon: 'facebook' },
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/tr%C3%A3n-ph%C3%BAc-hi%E1%BA%BFu-3987b2285', icon: 'linkedin' },
];
---

<BaseLayout activeNav="home">
  {/* Hero */}
  <section class="hero">
    <h1 class="hero-title">Phieu.work</h1>
    <p class="hero-tagline">Anime, games, films, sách — all in one place.</p>
    <div class="stats-grid-hero">
      <div class="stat-hero reveal">
        <p class="stat-hero-number" data-count={allAnime.length} style="color: var(--anime-color);">0</p>
        <p class="stat-hero-label">Anime</p>
        <div class="stat-hero-bar" style="background: var(--anime-color);"></div>
      </div>
      <div class="stat-hero reveal">
        <p class="stat-hero-number" data-count={allGames.length} style="color: var(--game-color);">0</p>
        <p class="stat-hero-label">Games</p>
        <div class="stat-hero-bar" style="background: var(--game-color);"></div>
      </div>
      <div class="stat-hero reveal">
        <p class="stat-hero-number" data-count={allFilms.length} style="color: var(--film-color);">0</p>
        <p class="stat-hero-label">Films</p>
        <div class="stat-hero-bar" style="background: var(--film-color);"></div>
      </div>
      <div class="stat-hero reveal">
        <p class="stat-hero-number" data-count={allBooks.length} style="color: var(--book-color);">0</p>
        <p class="stat-hero-label">Books</p>
        <div class="stat-hero-bar" style="background: var(--book-color);"></div>
      </div>
      <div class="stat-hero reveal">
        <p class="stat-hero-number" data-count={allPosts.length} style="color: var(--post-color);">0</p>
        <p class="stat-hero-label">Posts</p>
        <div class="stat-hero-bar" style="background: var(--post-color);"></div>
      </div>
    </div>
  </section>

  {/* Cover crowd — handpicked, scatters on scroll */}
  <div class="crowd-wrapper" aria-hidden="true">
    <div class="crowd-band">
      <div class="crowd-row crowd-back">
        {crowdBack.map((item, i) => (
          <div class="crowd-item"
            data-speed={0.3 + (i % 4) * 0.12}
            data-dir={i < Math.ceil(crowdBack.length / 2) ? 'left' : 'right'}
            style={`--crowd-y: ${-8 + (i % 4) * 5}px;`}>
            <img src={item.cover} alt={item.label} loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
      <div class="crowd-row crowd-front">
        {crowdFront.map((item, i) => (
          <div class="crowd-item"
            data-speed={0.4 + (i % 3) * 0.2}
            data-dir={i < Math.ceil(crowdFront.length / 2) ? 'left' : 'right'}
            style="--crowd-y: 0px;">
            <img src={item.cover} alt={item.label} loading="lazy" decoding="async" />
            <span class="crowd-label">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="crowd-fade"></div>
  </div>

  {/* Currently active */}
  {active.length > 0 && (
    <section class="home-block reveal">
      <div class="home-head">
        <p class="section-label">Đang theo dõi</p>
        <span class="home-head-count">{active.length}</span>
      </div>
      <div class="active-strip">
        {active.map(item => (
          <a href={`${base}${item.collection}/${item.slug}/`} class="active-chip" data-collection={item.collection}>
            {item.cover
              ? <img src={item.cover} alt="" loading="lazy" decoding="async" onerror="this.hidden=true" />
              : <span class="active-chip-fallback">{item.title.slice(0, 1)}</span>}
            <span class="active-chip-body">
              <span class="active-chip-title">{item.title}</span>
              <span class="active-chip-meta">
                <span class="active-chip-label">{item.label}</span>
                {item.detail && <span>{item.detail}</span>}
              </span>
              {item.progress !== undefined && (
                <span class="active-chip-progress" aria-label={`${item.progress}%`}>
                  <span style={`width: ${item.progress}%`}></span>
                </span>
              )}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* Featured posts */}
  {featuredPosts.length > 0 && (
    <section class="home-block reveal">
      <div class="home-head">
        <p class="section-label">Bài viết nổi bật</p>
        <a href={`${base}posts/`} class="home-head-link">Xem tất cả →</a>
      </div>
      <div class="feature-posts">
        {featuredPosts.map((post, i) => (
          <a href={`${base}posts/${post.id}/`} class={`feature-post ${i === 0 ? 'is-lead' : ''}`}>
            {post.image && (
              <img src={post.image} alt="" class="feature-post-image" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" onerror="this.hidden=true" />
            )}
            <span class="feature-post-shade"></span>
            <span class="feature-post-body">
              <span class="feature-post-tags">
                {post.tags.slice(0, 2).map(tag => <span class="post-tag">{tag}</span>)}
              </span>
              <span class="feature-post-title">{post.title}</span>
              {i === 0 && post.description && <span class="feature-post-desc">{post.description}</span>}
              <span class="feature-post-date">{new Date(post.date).toLocaleDateString('vi-VN')}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* Shelves */}
  {shelves.map(shelf => (
    <section class="shelf home-block reveal" data-shelf={shelf.key} data-view="recent" style={`--shelf-color: ${shelf.color}`}>
      <div class="shelf-head">
        <a href={`${base}${shelf.href}`} class="shelf-name">
          <span class="shelf-dot"></span>
          {shelf.label}
          <span class="shelf-count">{shelf.count}</span>
        </a>
        {shelf.count > 0 && (
          <div class="shelf-tabs" role="tablist" aria-label={`${shelf.label} view`}>
            <button type="button" class="shelf-tab active" data-view="recent" role="tab" aria-selected="true">Mới thêm</button>
            <button type="button" class="shelf-tab" data-view="top" role="tab" aria-selected="false">Điểm cao</button>
          </div>
        )}
        <a href={`${base}${shelf.href}`} class="home-head-link shelf-all">Xem tất cả →</a>
      </div>

      {shelf.count === 0 ? (
        <a href={`${base}${shelf.href}`} class="shelf-empty">
          <span class="shelf-empty-books" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </span>
          <span>
            <strong>Kệ {shelf.label.toLowerCase()} đang được sắp xếp</strong>
            <small>Danh sách sẽ sớm có mặt ở đây.</small>
          </span>
        </a>
      ) : (
        <div class="shelf-frame">
          <button type="button" class="shelf-arrow prev" aria-label="Cuộn trái" data-dir="-1">‹</button>
          {(['recent', 'top'] as const).map(view => (
            <div class="shelf-track" data-track={view}>
              {shelf[view].map(entry => (
                <ShelfCard
                  collection={shelf.key}
                  slug={entry.id}
                  title={entry.data.title}
                  cover={entry.data.cover}
                  rating={entry.data.rating}
                  meta={(shelf.meta as (e: typeof entry) => string)(entry)}
                />
              ))}
              <a href={`${base}${shelf.href}`} class="shelf-more">
                <span>Xem tất cả</span>
                <strong>{shelf.count}</strong>
              </a>
            </div>
          ))}
          <button type="button" class="shelf-arrow next" aria-label="Cuộn phải" data-dir="1">›</button>
        </div>
      )}
    </section>
  ))}

  {/* Projects + contact */}
  <section class="home-bottom reveal">
    <div>
      <p class="section-label">Dự án</p>
      <div class="home-projects">
        {projects.map(project => (
          <a href={project.url} class="home-project" target="_blank" rel="noopener">
            <span>
              <strong>{project.name}</strong>
              <small>{project.desc}</small>
            </span>
            <span class={`badge ${project.badgeClass}`}>{project.badge}</span>
          </a>
        ))}
      </div>
    </div>
    <div>
      <p class="section-label">Liên hệ</p>
      <div class="home-socials">
        {socials.map(social => (
          <a href={social.url} class="home-social" target="_blank" rel="noopener" title={social.name} aria-label={social.name}>
            {social.icon === 'github' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            )}
            {social.icon === 'instagram' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
            )}
            {social.icon === 'facebook' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            )}
            {social.icon === 'linkedin' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            )}
            <span>{social.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    function initShelves() {
      document.querySelectorAll<HTMLElement>('.shelf').forEach(shelf => {
        if (shelf.dataset.shelfBound === 'true') return;
        shelf.dataset.shelfBound = 'true';

        const tracks = [...shelf.querySelectorAll<HTMLElement>('.shelf-track')];
        const prev = shelf.querySelector<HTMLButtonElement>('.shelf-arrow.prev');
        const next = shelf.querySelector<HTMLButtonElement>('.shelf-arrow.next');
        const activeTrack = () => shelf.querySelector<HTMLElement>(`.shelf-track[data-track="${shelf.dataset.view}"]`);

        const syncArrows = () => {
          const track = activeTrack();
          if (!track || !prev || !next) return;
          const max = track.scrollWidth - track.clientWidth - 2;
          prev.disabled = track.scrollLeft <= 2;
          next.disabled = track.scrollLeft >= max;
          shelf.classList.toggle('at-start', track.scrollLeft <= 2);
          shelf.classList.toggle('at-end', track.scrollLeft >= max);
        };

        [prev, next].forEach(button => button?.addEventListener('click', () => {
          const track = activeTrack();
          if (!track) return;
          const step = Math.max(track.clientWidth * 0.85, 200) * Number(button.dataset.dir || 1);
          track.scrollBy({ left: step, behavior: 'smooth' });
        }));

        tracks.forEach(track => track.addEventListener('scroll', syncArrows, { passive: true }));

        shelf.querySelectorAll<HTMLButtonElement>('.shelf-tab').forEach(tab => {
          tab.addEventListener('click', () => {
            const view = tab.dataset.view || 'recent';
            shelf.dataset.view = view;
            shelf.querySelectorAll<HTMLButtonElement>('.shelf-tab').forEach(t => {
              const on = t === tab;
              t.classList.toggle('active', on);
              t.setAttribute('aria-selected', String(on));
            });
            const track = activeTrack();
            if (track) track.scrollLeft = 0;
            syncArrows();
          });
        });

        syncArrows();
        window.addEventListener('resize', syncArrows, { passive: true });
      });
    }
    initShelves();
    if (document.documentElement.dataset.shelvesEventsBound !== 'true') {
      document.documentElement.dataset.shelvesEventsBound = 'true';
      document.addEventListener('astro:page-load', initShelves);
    }
  </script>
</BaseLayout>
