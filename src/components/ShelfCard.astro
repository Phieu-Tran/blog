---
// Poster card used on the homepage shelves. Glows with the accent color sampled from its own cover.
import colors from '../data/cover-colors.json';

interface Props {
  collection: 'anime' | 'games' | 'films' | 'books';
  slug: string;
  title: string;
  cover?: string;
  rating: number;
  meta: string;
}
const { collection, slug, title, cover, rating, meta } = Astro.props;
const base = import.meta.env.BASE_URL;

// Steam "header.jpg" is landscape: prefer the portrait library art, fall back to the original.
const steamHeader = cover?.match(/\/steam\/apps\/(\d+)\/header\.jpg/);
const cardCover = steamHeader ? `https://cdn.cloudflare.steamstatic.com/steam/apps/${steamHeader[1]}/library_600x900.jpg` : cover;
const coverFallback = steamHeader ? cover : undefined;

const stored = (colors as Record<string, { cover: string; color: string | null }>)[`${collection}/${slug}`];
const glow = stored?.color && stored.cover === cover ? stored.color : undefined;
---

<a href={`${base}${collection}/${slug}/`} class="shelf-card" data-collection={collection} style={glow ? `--glow: ${glow}` : undefined}>
  <div class="shelf-cover">
    <span class="cover-fallback">{title.slice(0, 1)}</span>
    {cardCover && (
      <img
        src={cardCover}
        alt={title}
        loading="lazy"
        decoding="async"
        data-fallback={coverFallback}
        onerror="if(this.dataset.fallback){this.src=this.dataset.fallback;delete this.dataset.fallback}else{this.hidden=true}"
      />
    )}
    {rating > 0 ? (
      <span class="shelf-score">{rating}</span>
    ) : (
      <span class="shelf-score is-empty">—</span>
    )}
  </div>
  <p class="shelf-title">{title}</p>
  <p class="shelf-meta">{meta}</p>
</a>
