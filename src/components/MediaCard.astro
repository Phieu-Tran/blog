---
interface Props {
  title: string;
  type: 'anime' | 'game' | 'film' | 'book';
  rating: number;
  genre: string;
  year: number;
  cover?: string;
  status: string;
  slug: string;
  index?: number;
}
const { title, type, rating, genre, year, cover, status, slug, index = 0 } = Astro.props;
const base = import.meta.env.BASE_URL;
const stars = Math.round(rating / 2);
// Steam "header.jpg" is landscape and crops badly in a portrait card: try the portrait library art first.
const steamHeader = cover?.match(/\/steam\/apps\/(\d+)\/header\.jpg/);
const cardCover = steamHeader ? `https://cdn.cloudflare.steamstatic.com/steam/apps/${steamHeader[1]}/library_600x900.jpg` : cover;
const coverFallback = steamHeader ? cover : undefined;
const typeMap = { anime: 'anime', game: 'games', film: 'films', book: 'books' };
const typeLabel = { anime: 'anime', game: 'game', film: 'film', book: 'sách' };
const isActive = status === 'watching' || status === 'playing' || status === 'reading';
const statusLabels: Record<string, string> = {
  watching: 'Đang xem', playing: 'Đang chơi', reading: 'Đang đọc', completed: 'Đã xong',
  watched: 'Đã xem', read: 'Đã đọc', on_hold: 'Tạm dừng', plan: 'Dự định', dropped: 'Bỏ',
};
---

<a href={`${base}${typeMap[type]}/${slug}/`} class="media-card reveal" data-type={type}>
  <div class="card-cover">
    <span class="cover-fallback">{title.slice(0, 1)}</span>
    {cardCover && <img src={cardCover} alt={title} loading="lazy" decoding="async" data-fallback={coverFallback} onerror="if(this.dataset.fallback){this.src=this.dataset.fallback;delete this.dataset.fallback}else{this.hidden=true}" />}
    <div class="gradient-overlay"></div>
    <span class={`badge badge-${type}`} style="position:absolute;top:8px;left:8px;">
      {typeLabel[type]}
    </span>
    {isActive && (
      <span class="badge badge-game" style="position:absolute;top:8px;right:8px;display:flex;align-items:center;gap:4px;">
        <span style="width:5px;height:5px;border-radius:50%;background:#34D399;animation:pulse 2s infinite;display:inline-block;"></span>
        {statusLabels[status]}
      </span>
    )}
    <div style="position:absolute;bottom:8px;left:10px;display:flex;align-items:center;gap:6px;">
      {rating > 0 ? (
        <>
          <span class="stars">
        {[...Array(5)].map((_, i) => (
          <span class={i < stars ? 'star-on' : 'star-off'}>★</span>
        ))}
      </span>
          <span style="color:#FBBF24;font-size:12px;font-weight:600;">{rating}</span>
        </>
      ) : (
        <span style="color:rgba(255,255,255,0.55);font-size:11px;font-weight:600;letter-spacing:0.04em;">Chưa chấm</span>
      )}
    </div>
  </div>
  <div class="card-info">
    <p class="card-title">{title}</p>
    <p class="card-meta">{genre.split(',')[0]} — {year}</p>
  </div>
</a>
