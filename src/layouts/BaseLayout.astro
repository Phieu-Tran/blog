---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  activeNav?: string;
}
const {
  title = 'Phieu.work',
  description = 'Anime, games, films — all in one place',
  image,
  ogType = 'website',
  activeNav = 'home'
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === 'Phieu.work' ? 'Phieu.work' : `${title} — Phieu.work`;
const feedUrl = new URL(`${base}rss.xml`, Astro.site).toString();
const defaultImage = `${base}og/site.svg`;
const absoluteImage = new URL(image || defaultImage, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" type="application/rss+xml" title="Phieu.work Posts RSS" href={feedUrl} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Phieu.work" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={absoluteImage} />
  <meta property="og:image:alt" content={pageTitle} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <ViewTransitions />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImage} />
</head>
<body>
  <nav class="nav">
    <div class="nav-logo">
      <a href={base} style="display:flex;align-items:center;gap:10px;">
        <svg class="nav-logo-svg" width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="nav-g" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#A78BFA"/>
              <stop offset="50%" stop-color="#34D399"/>
              <stop offset="100%" stop-color="#FB923C"/>
            </linearGradient>
          </defs>
          <rect x="3" y="4" width="26" height="18" rx="3" stroke="url(#nav-g)" stroke-width="2"/>
          <line x1="16" y1="22" x2="16" y2="26" stroke="url(#nav-g)" stroke-width="2" stroke-linecap="round"/>
          <line x1="11" y1="26" x2="21" y2="26" stroke="url(#nav-g)" stroke-width="2" stroke-linecap="round"/>
          <polygon points="13,9 13,17 20,13" fill="url(#nav-g)" opacity="0.9"/>
          <rect x="22" y="7" width="2" height="2" rx="0.5" fill="#A78BFA" opacity="0.6"/>
          <rect x="22" y="11" width="2" height="2" rx="0.5" fill="#34D399" opacity="0.6"/>
          <rect x="22" y="15" width="2" height="2" rx="0.5" fill="#FB923C" opacity="0.6"/>
        </svg>
        <span class="nav-logo-text">Phieu.work</span>
      </a>
    </div>
    <button
      type="button"
      class="nav-search-button"
      aria-label="Search media"
      aria-controls="global-search"
      data-search-open
    >
      <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M16.5 16.5L21 21"></path>
      </svg>
    </button>
    <button class="nav-toggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-links">
      <a href={base} class={activeNav === 'home' ? 'active' : ''}>Trang chủ</a>
      <a href={`${base}anime/`} class={activeNav === 'anime' ? 'active' : ''}>Anime</a>
      <a href={`${base}games/`} class={activeNav === 'games' ? 'active' : ''}>Games</a>
      <a href={`${base}films/`} class={activeNav === 'films' ? 'active' : ''}>Films</a>
      <a href={`${base}steam/`} class={activeNav === 'steam' ? 'active' : ''} style="color:#66C0F4;">Steam</a>
      <a href={`${base}posts/`} class={activeNav === 'posts' ? 'active' : ''}>Posts</a>
    </div>
  </nav>

  <div
    id="global-search"
    class="global-search"
    data-search-index-url={`${base}search-index.json`}
    hidden
  >
    <div class="global-search-backdrop" data-search-close></div>
    <section class="global-search-panel" role="dialog" aria-modal="true" aria-labelledby="global-search-title">
      <div class="global-search-head">
        <h2 id="global-search-title">Search</h2>
        <button type="button" class="global-search-close" aria-label="Close search" data-search-close>
          <span></span>
          <span></span>
        </button>
      </div>
      <input
        id="global-search-input"
        class="global-search-input"
        type="search"
        placeholder="Anime, games, films..."
        autocomplete="off"
      />
      <p class="global-search-meta" id="global-search-meta">Anime / Games / Films</p>
      <div class="global-search-results" id="global-search-results"></div>
    </section>
  </div>

  <main class="container">
    <slot />
  </main>

  <footer style="border-top: 1px solid rgba(255,255,255,0.06); padding: 16px 24px; text-align: center;">
    <p style="font-size: 11px; color: rgba(255,255,255,0.2); font-family: 'Space Mono', monospace;">
      Phieu.work — powered by Obsidian + Astro
    </p>
  </footer>

  <script>
    type GlobalSearchItem = {
      title: string;
      type: 'anime' | 'game' | 'film';
      url: string;
      rating: number;
      year: number;
      genre: string;
      status: string;
      cover?: string;
    };

    let globalSearchItems: GlobalSearchItem[] | null = null;
    let globalSearchLoading: Promise<GlobalSearchItem[]> | null = null;

    function normalizeSearchText(value: string) {
      return value
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
    }

    function escapeHtml(value = '') {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function typeLabel(type: GlobalSearchItem['type']) {
      if (type === 'game') return 'Game';
      if (type === 'film') return 'Film';
      return 'Anime';
    }

    function getSearchDialog() {
      return document.getElementById('global-search') as HTMLElement | null;
    }

    function getSearchIndexUrl() {
      return getSearchDialog()?.dataset.searchIndexUrl || '/search-index.json';
    }

    async function loadGlobalSearchItems() {
      if (globalSearchItems) return globalSearchItems;
      if (globalSearchLoading) return globalSearchLoading;

      globalSearchLoading = fetch(getSearchIndexUrl(), { headers: { Accept: 'application/json' } })
        .then(response => {
          if (!response.ok) throw new Error(`Search index failed: ${response.status}`);
          return response.json();
        })
        .then(data => {
          globalSearchItems = Array.isArray(data.items) ? data.items : [];
          return globalSearchItems;
        })
        .finally(() => {
          globalSearchLoading = null;
        });

      return globalSearchLoading;
    }

    function scoreSearchItem(item: GlobalSearchItem, query: string, tokens: string[]) {
      const title = normalizeSearchText(item.title);
      const genre = item.genre || '';
      const haystack = normalizeSearchText(`${item.title} ${item.type} ${genre} ${item.year} ${item.status || ''}`);
      if (tokens.length && !tokens.every(token => haystack.includes(token))) return -1;

      let score = Number(item.rating || 0);
      if (!query) return score;
      if (title === query) score += 100;
      else if (title.startsWith(query)) score += 55;
      else if (title.includes(query)) score += 25;
      if (normalizeSearchText(genre).includes(query)) score += 8;
      return score;
    }

    function renderGlobalSearchResults() {
      const input = document.getElementById('global-search-input') as HTMLInputElement | null;
      const results = document.getElementById('global-search-results');
      const meta = document.getElementById('global-search-meta');
      if (!input || !results || !meta || !globalSearchItems) return;

      const query = normalizeSearchText(input.value);
      const tokens = query.split(/\s+/).filter(Boolean);
      const matches = globalSearchItems
        .map(item => ({ item, score: scoreSearchItem(item, query, tokens) }))
        .filter(row => row.score >= 0)
        .sort((a, b) => b.score - a.score || a.item.title.localeCompare(b.item.title))
        .slice(0, 14)
        .map(row => row.item);

      meta.textContent = query ? `${matches.length} results` : 'Top rated media';

      if (!matches.length) {
        results.innerHTML = '<p class="global-search-empty">No matches.</p>';
        return;
      }

      results.innerHTML = matches.map(item => {
        const badgeClass = item.type === 'game' ? 'badge-game' : item.type === 'film' ? 'badge-film' : 'badge-anime';
        const fallback = escapeHtml(item.title.slice(0, 1));
        const image = item.cover
          ? `<img src="${escapeHtml(item.cover)}" alt="" loading="lazy" decoding="async" onerror="this.hidden=true" />`
          : '';
        const primaryGenre = String(item.genre || '').split(',')[0] || 'N/A';
        return `
          <a class="global-search-result" href="${escapeHtml(item.url)}">
            <span class="global-search-thumb">
              <span>${fallback}</span>
              ${image}
            </span>
            <span class="global-search-copy">
              <strong>${escapeHtml(item.title)}</strong>
              <small>${escapeHtml(primaryGenre)} - ${escapeHtml(String(item.year || 'N/A'))}</small>
            </span>
            <span class="badge ${badgeClass}">${typeLabel(item.type)}</span>
            <span class="global-search-score">${escapeHtml(String(item.rating || 0))}</span>
          </a>
        `;
      }).join('');
    }

    async function openGlobalSearch() {
      const dialog = getSearchDialog();
      if (!dialog) return;
      dialog.hidden = false;
      document.body.classList.add('search-open');
      document.querySelectorAll('[data-search-open]').forEach(button => {
        button.setAttribute('aria-expanded', 'true');
      });

      const input = document.getElementById('global-search-input') as HTMLInputElement | null;
      const results = document.getElementById('global-search-results');
      const meta = document.getElementById('global-search-meta');
      if (meta && !globalSearchItems) meta.textContent = 'Loading...';
      if (results && !globalSearchItems) results.innerHTML = '';

      window.setTimeout(() => input?.focus(), 0);

      try {
        await loadGlobalSearchItems();
        renderGlobalSearchResults();
      } catch {
        if (meta) meta.textContent = 'Search unavailable.';
      }
    }

    function closeGlobalSearch() {
      const dialog = getSearchDialog();
      if (!dialog || dialog.hidden) return;
      dialog.hidden = true;
      document.body.classList.remove('search-open');
      document.querySelectorAll('[data-search-open]').forEach(button => {
        button.setAttribute('aria-expanded', 'false');
      });
    }

    function shouldIgnoreSearchShortcut(event: KeyboardEvent) {
      const target = event.target as HTMLElement | null;
      if (!target) return false;
      const tag = target.tagName;
      return target.isContentEditable || tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
    }

    function initGlobalSearch() {
      if (document.documentElement.dataset.globalSearchBound === 'true') return;
      document.documentElement.dataset.globalSearchBound = 'true';

      document.addEventListener('click', event => {
        const target = event.target as HTMLElement | null;
        if (!target) return;
        if (target.closest('[data-search-open]')) {
          event.preventDefault();
          openGlobalSearch();
        } else if (target.closest('[data-search-close]')) {
          event.preventDefault();
          closeGlobalSearch();
        } else if (target.closest('.global-search-result')) {
          closeGlobalSearch();
        }
      });

      document.addEventListener('input', event => {
        const target = event.target as HTMLElement | null;
        if (target?.id === 'global-search-input') renderGlobalSearchResults();
      });

      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
          closeGlobalSearch();
          return;
        }

        const wantsSearch = (event.key === 'k' && (event.ctrlKey || event.metaKey)) ||
          (event.key === '/' && !shouldIgnoreSearchShortcut(event));
        if (!wantsSearch) return;

        event.preventDefault();
        openGlobalSearch();
      });
    }

    function init() {
      initGlobalSearch();

      // Mobile nav toggle
      const toggle = document.querySelector('.nav-toggle') as HTMLElement | null;
      const links = document.querySelector('.nav-links') as HTMLElement | null;
      if (toggle && links && toggle.dataset.navToggleBound !== 'true') {
        toggle.dataset.navToggleBound = 'true';
        toggle.addEventListener('click', () => {
          const isOpen = links.classList.toggle('open');
          toggle.classList.toggle('open', isOpen);
          toggle.setAttribute('aria-expanded', String(isOpen));
        });
      }

      // Scroll reveal — IntersectionObserver
      const reveals = document.querySelectorAll('.reveal');
      if (reveals.length) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        reveals.forEach(el => observer.observe(el));
      }

      // Top carousel horizontal wheel scroll
      const carousels = document.querySelectorAll('.top-carousel');
      carousels.forEach(carousel => {
        const el = carousel as HTMLElement;
        if (el.dataset.wheelScrollBound === 'true') return;
        el.dataset.wheelScrollBound = 'true';

        el.addEventListener('wheel', event => {
          const wheelEvent = event as WheelEvent;
          if (el.scrollWidth <= el.clientWidth) return;

          const isMostlyHorizontal = Math.abs(wheelEvent.deltaX) > Math.abs(wheelEvent.deltaY);
          if (isMostlyHorizontal) return;

          const maxScroll = el.scrollWidth - el.clientWidth;
          const nextScroll = Math.max(0, Math.min(maxScroll, el.scrollLeft + wheelEvent.deltaY));
          if (nextScroll === el.scrollLeft) return;

          wheelEvent.preventDefault();
          el.scrollLeft = nextScroll;
        }, { passive: false });
      });

      // Cover crowd scatter — driven by scroll position
      const crowdItems = document.querySelectorAll('.crowd-item');
      const crowdWrapper = document.querySelector('.crowd-wrapper');
      if (crowdItems.length && crowdWrapper) {
        const onScroll = () => {
          const rect = crowdWrapper.getBoundingClientRect();
          const wh = window.innerHeight;
          // progress: 0 when crowd is in view, 1 when scrolled past
          const progress = Math.max(0, Math.min(1, -rect.top / (rect.height + 100)));

          crowdItems.forEach(item => {
            const el = item as HTMLElement;
            const speed = parseFloat(el.dataset.speed || '0.5');
            const dir = el.dataset.dir === 'left' ? -1 : 1;
            const distance = progress * speed * window.innerWidth * 0.8;
            const fade = Math.max(0, 1 - progress * 1.5);
            el.style.transform = `translateX(${dir * distance}px) translateY(${el.style.getPropertyValue('--crowd-y') || '0px'})`;
            el.style.opacity = String(fade);
          });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll(); // initial position
      }

      // Counter animation — counts from 0 to data-count
      const counters = document.querySelectorAll('[data-count]');
      if (counters.length) {
        const counterObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const target = parseInt(el.dataset.count || '0', 10);
            if (!target) return;
            counterObserver.unobserve(el);
            const duration = 1200;
            const start = performance.now();
            const step = (now: number) => {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              // ease-out cubic
              const eased = 1 - Math.pow(1 - progress, 3);
              el.textContent = Math.round(eased * target).toString();
              if (progress < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          });
        }, { threshold: 0.3 });
        counters.forEach(el => counterObserver.observe(el));
      }
    }

    function closeTransientUi() {
      closeGlobalSearch();
      document.querySelector('.nav-links')?.classList.remove('open');
      const toggle = document.querySelector('.nav-toggle') as HTMLElement | null;
      toggle?.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    }

    // Run on initial load
    init();
    // Re-run after View Transitions navigate
    if (document.documentElement.dataset.baseLayoutEventsBound !== 'true') {
      document.documentElement.dataset.baseLayoutEventsBound = 'true';
      document.addEventListener('astro:page-load', init);
      document.addEventListener('astro:before-swap', closeTransientUi);
    }
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
